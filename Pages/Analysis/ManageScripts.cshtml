@page
@model SmartLab.Pages.Analysis.ManageScriptsModel
@{
    ViewData["Title"] = "Analysis";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Analysis Scripts</h1>
    <div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#uploadModal">
            Upload New Script
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<h3>Built-in Scripts</h3>
@if (Model.BuiltInScripts.Count == 0)
{
    <p>No built-in scripts available.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Language</th>
                <th>Version</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var script in Model.BuiltInScripts)
            {
                <tr>
                    <td>@script.DisplayName</td>
                    <td>@script.Description</td>
                    <td>@script.Language</td>
                    <td>v@script.Version</td>
                </tr>
            }
        </tbody>
    </table>
}

<h3>My Scripts</h3>
@if (Model.UserScripts.Count == 0)
{
    <p>You haven't uploaded any scripts yet. Click "Upload New Script" to get started.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Status</th>
                <th>Uploaded</th>
                <th>Executions</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var script in Model.UserScripts)
            {
                <tr>
                    <td>@script.DisplayName</td>
                    <td>@script.Description</td>
                    <td>
                        @if (script.ValidationStatus == SmartLab.Domains.Analysis.Models.ValidationStatus.Passed)
                        {
                            <span class="badge bg-success">Validated</span>
                        }
                        else if (script.ValidationStatus == SmartLab.Domains.Analysis.Models.ValidationStatus.Failed)
                        {
                            <span class="badge bg-danger">Failed</span>
                        }
                        else if (script.ValidationStatus == SmartLab.Domains.Analysis.Models.ValidationStatus.Warning)
                        {
                            <span class="badge bg-warning text-dark">Warning</span>
                        }
                    </td>
                    <td>@script.UploadDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@script.ExecutionCount</td>
                    <td>
                        <div class="button-container">
                            <form method="post" asp-page-handler="Delete" asp-route-id="@script.Id" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this script?');">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- Upload Modal -->
<div class="modal fade" id="uploadModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Upload" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title">Upload Analysis Script</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- File Upload -->
                    <div class="mb-3">
                        <label for="scriptFile" class="form-label">
                            Python Script File <span class="text-danger">*</span>
                        </label>
                        <input type="file" class="form-control" id="scriptFile" name="scriptFile" accept=".py" required>
                        <div class="form-text">Only .py files are accepted. Max size: 1 MB</div>
                    </div>

                    <!-- Display Name -->
                    <div class="mb-3">
                        <label for="displayName" class="form-label">
                            Display Name <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control" id="displayName" name="displayName" placeholder="e.g., FFT Analysis" required>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea class="form-control" id="description" name="description" rows="3" placeholder="Describe what this script does..."></textarea>
                    </div>

                    <!-- Tags -->
                    <div class="mb-3">
                        <label for="tags" class="form-label">Tags</label>
                        <input type="text" class="form-control" id="tags" name="tags" placeholder="e.g., fft, frequency, signal-processing (comma-separated)">
                    </div>

                    <!-- Version -->
                    <div class="mb-3">
                        <label for="version" class="form-label">Version</label>
                        <input type="text" class="form-control" id="version" name="version" value="1.0.0" placeholder="1.0.0">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Upload & Validate</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
.button-container {
    display: flex;
    gap: 5px;
}
</style>
